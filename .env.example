# ── Database ────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Better Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_plus_char_secret_here

# Full URL of your app (no trailing slash)
# Local:      http://localhost:3000
# Production: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# ── Discord OAuth ────────────────────────────────────────────────
# From discord.com/developers/applications → Your App → OAuth2
# Redirect URI to register: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ── Payments ─────────────────────────────────────────────────────
# Ethereum address that receives on-chain payments (Base mainnet)
MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# Exposed to the browser — must match MERCHANT_ADDRESS
NEXT_PUBLIC_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Email (Resend) ────────────────────────────────────────────────
# Required for email OTP sign-in — get yours at resend.com
RESEND_API_KEY=re_your_api_key_here

# ── Optional ─────────────────────────────────────────────────────
# Set to "true" to enable Next.js bundle analyzer
# ANALYZE=false
