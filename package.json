    "vitest": "^4.1.2",
    "webpack": "5.105.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "tmp@<=0.2.3": ">=0.2.4"
    }
  }
}
