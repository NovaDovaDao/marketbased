  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-syntax-flow": "^7.28.6",
    "@babel/plugin-transform-optional-chaining": "^7.28.6",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "16.2.1",
