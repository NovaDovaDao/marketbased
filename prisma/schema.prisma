// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Transaction {
  id String @id @default(cuid())

  txHash String @unique

  // Relations
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])

  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  // Keep email for external payments (optional fallback)
  buyerEmail String?

  // Flexible amount (supports crypto OR runes)
  amount Json // { "usdc": 100 } OR { "runes": [...] }

  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([buyerId])
  @@index([status])
  @@map("transaction")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String    @unique
  usernameUpdatedAt DateTime?

  listings        Listing[]
  offers          Offer[]
  transactions    Transaction[]
  walletAddresses WalletAddress[]
  sellerRooms     TradeRoom[]     @relation("SellerRooms")
  buyerRooms      TradeRoom[]     @relation("BuyerRooms")
  messages        Message[]
  messageReports  MessageReport[]

  createdAt     DateTime  @default(now())
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Better Auth admin plugin fields
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Space Dust balance (in-app currency)
  spaceDust Int @default(0)

  purchases       Purchase[]
  buyerPurchases  ItemPurchase[] @relation("BuyerItemPurchases")
  sellerPurchases ItemPurchase[] @relation("SellerItemPurchases")

  @@map("user")
}

model Listing {
  id String @id @default(uuid())

  contentId String

  name     String
  baseName String
  rarity   String

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  price Json // rune or crypto pricing

  // Optional Space Dust price for direct SD purchases
  spaceDustPrice Int?

  status String @default("active")

  offers        Offer[]
  transactions  Transaction[]
  itemPurchases ItemPurchase[]

  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([sellerId])
  @@index([status])
  @@map("listing")
}

model Offer {
  id String @id @default(uuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  offerData Json // runes / items
  status    String @default("pending")

  transaction Transaction?
  tradeRoom   TradeRoom?

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([buyerId])
  @@map("offer")
}

model TradeRoom {
  id String @id @default(cuid())

  // Optional: null for direct Space Dust purchases (no offer negotiation)
  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id])

  sellerId String
  seller   User   @relation("SellerRooms", fields: [sellerId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerRooms", fields: [buyerId], references: [id])

  // active | completed | cancelled
  status String @default("active")

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@map("trade_room")
}

model Message {
  id String @id @default(cuid())

  tradeRoomId String
  tradeRoom   TradeRoom @relation(fields: [tradeRoomId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content   String  @db.Text
  // text | system
  type      String  @default("text")
  isDeleted Boolean @default(false)

  // { "userId": "ISO-timestamp" }
  readAt Json?

  reports MessageReport[]

  createdAt DateTime @default(now())

  @@index([tradeRoomId, createdAt])
  @@index([senderId])
  @@map("message")
}

model MessageReport {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id])

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  reason String
  // pending | reviewed | dismissed
  status String @default("pending")

  createdAt DateTime @default(now())

  @@unique([messageId, reporterId])
  @@index([status])
  @@map("message_report")
}

model WalletAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String   @unique
  chainId   Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("wallet_address")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountUsd   Int // in cents, e.g. 1000 = $10.00
  spaceDust   Int
  provider    String // "stripe" | "paypal" | "base"
  providerRef String? // Stripe session ID, PayPal order ID, or txHash
  status      String   @default("pending") // "pending" | "completed" | "failed"
  createdAt   DateTime @default(now())

  @@unique([providerRef])
  @@index([userId])
  @@index([status])
  @@index([provider, status])
  @@map("purchase")
}

// Records every item purchased with Space Dust (peer-to-peer or catalog)
model ItemPurchase {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           User     @relation("BuyerItemPurchases", fields: [buyerId], references: [id])
  sellerId        String?
  seller          User?    @relation("SellerItemPurchases", fields: [sellerId], references: [id])
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id])
  runeId          Int? // for rune vault catalog purchases
  itemName        String
  spaceDustAmount Int
  tradeRoomId     String? // linked room for peer-to-peer purchases
  createdAt       DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@map("item_purchase")
}
