// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

//////////////////////////////////////////////////////
// D2R ITEM ENUMS
//////////////////////////////////////////////////////

enum ItemRarity {
  NORMAL
  MAGIC
  RARE
  SET
  UNIQUE
  RUNEWORD
  CRAFTED
}

enum ItemType {
  HELMET
  ARMOR
  SHIELD
  GLOVES
  BOOTS
  BELT
  WEAPON
  RING
  AMULET
  CHARM
  JEWEL
  RUNE
  GEM
  MISC
}

enum EquipmentSlot {
  HEAD
  BODY
  HANDS
  FEET
  WAIST
  WEAPON
  OFFHAND
  FINGER
  NECK
  INVENTORY
}

enum GameMode {
  SOFTCORE
  HARDCORE
}

enum LadderType {
  LADDER
  NON_LADDER
}

model Transaction {
  id String @id @default(cuid())

  txHash String @unique

  // Relations
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])

  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  // Keep email for external payments (optional fallback)
  buyerEmail String?

  // Flexible amount (supports crypto OR runes)
  amount Json // { "usdc": 100 } OR { "runes": [...] }

  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([buyerId])
  @@index([status])
  @@map("transaction")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String    @unique
  usernameUpdatedAt DateTime?

  listings        Listing[]
  offers          Offer[]
  transactions    Transaction[]
  walletAddresses WalletAddress[]
  sellerRooms     TradeRoom[]     @relation("SellerRooms")
  buyerRooms      TradeRoom[]     @relation("BuyerRooms")
  messages        Message[]
  messageReports  MessageReport[]

  createdAt     DateTime  @default(now())
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Better Auth admin plugin fields
  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Space Dust balance (in-app currency)
  spaceDust Int @default(0)

  purchases         Purchase[]
  buyerPurchases    ItemPurchase[]      @relation("BuyerItemPurchases")
  sellerPurchases   ItemPurchase[]      @relation("SellerItemPurchases")
  sentTransfers     SpaceDustTransfer[] @relation("SentTransfers")
  receivedTransfers SpaceDustTransfer[] @relation("ReceivedTransfers")

  @@map("user")
}

model Listing {
  id String @id @default(uuid())

  contentId String

  name     String
  baseName String
  rarity   String

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  price Json // rune or crypto pricing

  // Optional Space Dust price for direct SD purchases
  spaceDustPrice Int?

  status String @default("active")

  // D2R item instance (optional – null for legacy/catalog listings)
  itemInstanceId String?       @unique
  instance       ItemInstance? @relation(fields: [itemInstanceId], references: [id])

  // SPACE_DUST | RUNE | ITEM (null = legacy)
  tradeCurrency String?

  offers        Offer[]
  transactions  Transaction[]
  itemPurchases ItemPurchase[]

  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([sellerId])
  @@index([status])
  @@index([tradeCurrency])
  @@map("listing")
}

model Offer {
  id String @id @default(uuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation(fields: [buyerId], references: [id])

  offerData Json // runes / items
  status    String @default("pending")

  transaction Transaction?
  tradeRoom   TradeRoom?

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([buyerId])
  @@map("offer")
}

model TradeRoom {
  id String @id @default(cuid())

  // Optional: null for direct Space Dust purchases (no offer negotiation)
  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id])

  sellerId String
  seller   User   @relation("SellerRooms", fields: [sellerId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerRooms", fields: [buyerId], references: [id])

  // active | completed | cancelled
  status String @default("active")

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
  @@map("trade_room")
}

model Message {
  id String @id @default(cuid())

  tradeRoomId String
  tradeRoom   TradeRoom @relation(fields: [tradeRoomId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content   String  @db.Text
  // text | system
  type      String  @default("text")
  isDeleted Boolean @default(false)

  // { "userId": "ISO-timestamp" }
  readAt Json?

  reports MessageReport[]

  createdAt DateTime @default(now())

  @@index([tradeRoomId, createdAt])
  @@index([senderId])
  @@map("message")
}

model MessageReport {
  id String @id @default(cuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id])

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  reason String
  // pending | reviewed | dismissed
  status String @default("pending")

  createdAt DateTime @default(now())

  @@unique([messageId, reporterId])
  @@index([status])
  @@map("message_report")
}

model WalletAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String   @unique
  chainId   Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("wallet_address")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model WalletNonce {
  id        String   @id
  userId    String
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("wallet_nonce")
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountUsd   Int // in cents, e.g. 1000 = $10.00
  spaceDust   Int
  provider    String // "stripe" | "paypal" | "base"
  providerRef String? // Stripe session ID, PayPal order ID, or txHash
  status      String   @default("pending") // "pending" | "completed" | "failed"
  createdAt   DateTime @default(now())

  @@unique([providerRef])
  @@index([userId])
  @@index([status])
  @@index([provider, status])
  @@map("purchase")
}

// Records every item purchased with Space Dust (peer-to-peer or catalog)
model ItemPurchase {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           User     @relation("BuyerItemPurchases", fields: [buyerId], references: [id])
  sellerId        String?
  seller          User?    @relation("SellerItemPurchases", fields: [sellerId], references: [id])
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id])
  runeId          Int? // for rune vault catalog purchases
  itemName        String
  spaceDustAmount Int
  tradeRoomId     String? // linked room for peer-to-peer purchases
  createdAt       DateTime @default(now())

  @@index([buyerId])
  @@index([sellerId])
  @@map("item_purchase")
}

// Audit log for peer-to-peer Space Dust transfers (like D2JSP forum gold sends)
model SpaceDustTransfer {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentTransfers", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("ReceivedTransfers", fields: [recipientId], references: [id])
  amount      Int // always positive; deducted from sender, added to recipient
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@map("space_dust_transfer")
}

//////////////////////////////////////////////////////
// D2R ITEM CATALOG
//////////////////////////////////////////////////////

// Every D2R base type (Shako, Phase Blade, etc.)
model BaseItem {
  id          String   @id @default(cuid())
  name        String
  type        ItemType
  baseType    String // e.g. "Elite", "Normal"
  ilvl        Int?
  requiredLvl Int?

  minDamage  Int?
  maxDamage  Int?
  defense    Int?
  durability Int?
  socketsMax Int?

  stackable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uniques   UniqueItem[]
  setItems  SetItem[]
  instances ItemInstance[]

  @@index([name])
  @@index([type])
  @@map("base_item")
}

// Unique item definitions (Shako, Windforce, etc.)
model UniqueItem {
  id         String   @id @default(cuid())
  name       String
  baseItemId String
  level      Int?
  stats      Json
  lore       String?
  createdAt  DateTime @default(now())

  baseItem BaseItem @relation(fields: [baseItemId], references: [id])

  @@index([name])
  @@map("unique_item")
}

// Set definitions (Tal Rasha's, Immortal King, etc.)
model ItemSet {
  id        String   @id @default(cuid())
  name      String
  bonuses   Json
  createdAt DateTime @default(now())

  items SetItem[]

  @@map("item_set")
}

model SetItem {
  id         String   @id @default(cuid())
  name       String
  setId      String
  baseItemId String
  stats      Json
  createdAt  DateTime @default(now())

  set      ItemSet  @relation(fields: [setId], references: [id])
  baseItem BaseItem @relation(fields: [baseItemId], references: [id])

  @@map("set_item")
}

// Runeword definitions (Enigma, Faith, etc.)
model Runeword {
  id         String   @id @default(cuid())
  name       String   @unique
  runes      String[] // ["Jah", "Ith", "Ber"]
  bases      String[] // ["armor", "weapon"] — valid base type names
  attributes String[] // raw text lines e.g. "+2 To All Skills"
  stats      Json

  level  Int? // required character level
  ladder Boolean? // ladder-only flag
  tier   Int? // power ranking
  patch  Float? // version introduced (2.4, 2.6, etc.)

  createdAt DateTime @default(now())

  @@index([name])
  @@map("runeword")
}

// Magic/Rare/Crafted affix pool
model Affix {
  id        String   @id @default(cuid())
  name      String
  type      String // "prefix" | "suffix"
  tier      Int?
  statKey   String // e.g. "enhanced_damage"
  minValue  Int?
  maxValue  Int?
  levelReq  Int?
  createdAt DateTime @default(now())

  items ItemAffix[]

  @@index([name])
  @@index([statKey])
  @@map("affix")
}

// A real player-owned item instance (goes on the marketplace)
model ItemInstance {
  id         String     @id @default(cuid())
  baseItemId String
  rarity     ItemRarity

  name       String?
  ilvl       Int?
  sockets    Int?
  ethereal   Boolean @default(false)
  identified Boolean @default(true)

  // Game mode + ladder classification
  gameMode GameMode   @default(SOFTCORE)
  ladder   LadderType @default(NON_LADDER)

  stats   Json // rolled stat map e.g. { "enhanced_damage": 200 }
  rawText String? // optional OCR paste from in-game tooltip

  // Search / scoring fields — computed at write time
  statKeys   String[] // extracted stat keys e.g. ["fcr", "life", "res"]
  searchText String? // flat string for GIN search e.g. "shako +2 skills mf"
  score      Float? // computed sortable value
  isPerfect  Boolean? // true when all affix rolls are at max

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baseItem BaseItem    @relation(fields: [baseItemId], references: [id])
  affixes  ItemAffix[]
  listing  Listing?

  @@index([rarity])
  @@index([ilvl])
  @@index([baseItemId])
  @@index([ethereal])
  @@index([sockets])
  @@index([gameMode])
  @@index([ladder])
  @@map("item_instance")
}

// ItemInstance ↔ Affix join with rolled value
model ItemAffix {
  id      String @id @default(cuid())
  itemId  String
  affixId String
  value   Int?

  item  ItemInstance @relation(fields: [itemId], references: [id])
  affix Affix        @relation(fields: [affixId], references: [id])

  @@index([itemId])
  @@map("item_affix")
}

// Rune catalog (distinct from BaseItem type:RUNE; used for runeword lookups)
model Rune {
  id        String   @id @default(cuid())
  name      String   @unique // "Jah"
  tier      Int // 1–33 ranking
  createdAt DateTime @default(now())

  @@map("rune")
}

// Canonical stat registry for normalization + display
model StatDefinition {
  id       String  @id @default(cuid())
  key      String  @unique // "faster_cast_rate"
  display  String // "Faster Cast Rate"
  category String? // "offense" | "defense" | "utility" | "misc"

  createdAt DateTime @default(now())

  @@index([key])
  @@map("stat_definition")
}

// Gems catalog
model Gem {
  id        String   @id @default(cuid())
  name      String
  gemType   String // "amethyst" | "diamond" | "emerald" | "ruby" | "sapphire" | "skull" | "topaz"
  tier      String // "chipped" | "flawed" | "normal" | "flawless" | "perfect"
  effect    Json
  createdAt DateTime @default(now())

  @@index([gemType])
  @@map("gem")
}
